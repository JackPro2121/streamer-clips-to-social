# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Required ---------------------------------------------------------------
GEMINI_API_KEY=

# --- Optional: key rotation (rate-limit resilience) -------------------------
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=

# --- Optional: discovery / media -------------------------------------------
# APIFY_API_TOKEN=
# FIRECRAWL_API_KEY=
# GROQ_API_KEY=
# PEXELS_API_KEY=

# --- Optional: isolated streamer publishing (never the podcast token) -------
# STREAMER_BUFFER_ACCESS_TOKEN=
# STREAMER_BUFFER_CHANNEL_IDS=
# STREAMER_WATERMARK=@streamersclips

# --- Optional: engine path overrides ---------------------------------------
# CLIPS_CORE_ROOT=
# CLIPS_CORE_MODELS_DIR=
# CLIPS_CORE_ASSETS_DIR=
